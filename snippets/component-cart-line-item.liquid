{% doc %}
  Renders one cart line. Shared by the cart drawer and the cart page so a
  change to how a line looks is made once.

  Lines are addressed by `line_item.key`, never by index — rules (gift with
  purchase, kit integrity) add and remove lines between a click and its
  request, which shifts indices.

  Four states, decided here:
    - default            stepper (respects quantity rules) and remove link
    - with components    Shopify Bundles / Cart Transform `expand` lines list
                         their `item_components` under the parent
    - kit child          `_kit_role: child` lines render compact, no stepper
    - gift               `_gwp` lines are locked: no stepper, no remove

  The `<a>` stepper links work without JavaScript (they hit /cart/change with
  the key). <cart-line-item> (component-cart-line-item.js) intercepts them.

  @param {object} line_item - the cart line

  @example
  {% for line_item in cart.items %}
    {% render 'component-cart-line-item', line_item: line_item %}
  {% endfor %}
{% enddoc %}

{%- liquid
  assign is_gift = false
  assign is_kit_child = false
  if line_item.properties._gwp != blank
    assign is_gift = true
  endif
  if line_item.properties._kit_role == 'child'
    assign is_kit_child = true
  endif

  assign rule = line_item.variant.quantity_rule
  assign qty_min = rule.min | default: 1
  assign qty_step = rule.increment | default: 1
  assign qty_max = rule.max
  assign qty_down = line_item.quantity | minus: qty_step
  if qty_down < qty_min
    assign qty_down = 0
  endif
  assign qty_up = line_item.quantity | plus: qty_step
-%}

<cart-line-item
  class="cart-item{% if is_gift %} cart-item--gift{% endif %}{% if is_kit_child %} cart-item--kit-child{% endif %}"
  data-key="{{ line_item.key }}"
  {% if line_item.properties._kit_id != blank %}
    data-kit-id="{{ line_item.properties._kit_id | escape }}"
  {% endif %}
>
  <div class="cart-item__media">
    {%- if line_item.image -%}
      {{ line_item.image | image_url: width: 200 | image_tag: alt: line_item.title }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>

  <div class="cart-item__details">
    <div class="cart-item__heading">
      <a href="{{ line_item.url }}">{{ line_item.title | escape }}</a>

      {%- if settings.show_vendor -%}
        <p class="cart-item__vendor">{{ line_item.vendor | escape }}</p>
      {%- endif -%}

      <small class="cart-item__price">
        {%- if is_gift -%}
          <span class="cart-item__gift-label">{{ 'cart.free_gift' | t }}</span>
        {%- else -%}
          {%- if line_item.original_price > line_item.final_price -%}
            <s>{{ line_item.original_price | money }}</s>
          {%- endif -%}
          <span>{{ line_item.final_price | money }}</span>
        {%- endif -%}
      </small>

      {%- if line_item.product.has_only_default_variant == false
        or line_item.properties.size != 0
        or line_item.selling_plan_allocation != null
      -%}
        <dl class="cart-item__options">
          {%- if line_item.product.has_only_default_variant == false -%}
            {%- for option in line_item.options_with_values -%}
              <div class="cart-item__option">
                <dt>{{ option.name }}:</dt>
                <dd>{{ option.value }}</dd>
              </div>
            {%- endfor -%}
          {%- endif -%}

          {%- for property in line_item.properties -%}
            {%- assign property_first_char = property.first | slice: 0 -%}
            {%- if property.last != blank and property_first_char != '_' -%}
              <div class="cart-item__option">
                <dt>{{ property.first }}:</dt>
                <dd>
                  {%- if property.last contains '/uploads/' -%}
                    <a href="{{ property.last }}" target="_blank" aria-describedby="a11y-new-window-message">
                      {{ property.last | split: '/' | last }}
                    </a>
                  {%- else -%}
                    {{ property.last }}
                  {%- endif -%}
                </dd>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </dl>

        {%- if line_item.selling_plan_allocation != null -%}
          <p class="cart-item__option">{{ line_item.selling_plan_allocation.selling_plan.name }}</p>
        {%- endif -%}
      {%- endif -%}

      {%- if line_item.item_components.size > 0 -%}
        <ul class="cart-item__components">
          {%- for component in line_item.item_components -%}
            <li>{{ component.quantity }} &times; {{ component.title | escape }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if line_item.line_level_discount_allocations.size > 0 -%}
        <ul class="cart-discounts">
          {%- for discount_allocation in line_item.line_level_discount_allocations -%}
            <li>
              {{- 'icon-discount.svg' | inline_asset_content -}}
              {{ discount_allocation.discount_application.title }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="cart-item__action">
      {%- if is_gift or is_kit_child -%}
        <span class="cart-item__quantity-static">
          {{ 'cart.quantity_label' | t }}: {{ line_item.quantity }}
        </span>
      {%- else -%}
        <div class="cart-quantity">
          <a
            href="{{ routes.cart_change_url }}?id={{ line_item.key }}&quantity={{ qty_down }}"
            data-step="-1"
            aria-label="{{ 'cart.decrease_quantity' | t: title: line_item.title | escape }}"
          >
            {{- 'icon-minus.svg' | inline_asset_content -}}
          </a>

          <input
            type="number"
            name="updates[]"
            value="{{ line_item.quantity }}"
            min="{{ qty_min }}"
            step="{{ qty_step }}"
            {% if qty_max %}max="{{ qty_max }}"{% endif %}
            aria-label="{{ 'cart.quantity_for' | t: title: line_item.title | escape }}"
            form="cart-checkout-form"
          >

          <a
            href="{{ routes.cart_change_url }}?id={{ line_item.key }}&quantity={{ qty_up }}"
            data-step="1"
            aria-label="{{ 'cart.increase_quantity' | t: title: line_item.title | escape }}"
          >
            {{- 'icon-plus.svg' | inline_asset_content -}}
          </a>
        </div>

        <div class="cart-item__remove">
          {{- 'icon-close.svg' | inline_asset_content -}}
          <a href="{{ line_item.url_to_remove }}" data-remove>{{ 'cart.remove' | t }}</a>
        </div>
      {%- endif -%}
    </div>

    <div class="cart-item__total">
      {%- if line_item.original_line_price != line_item.final_line_price -%}
        <s>{{ line_item.original_line_price | money }}</s>
        <span>{{ line_item.final_line_price | money }}</span>
      {%- else -%}
        <span>{{ line_item.original_line_price | money }}</span>
      {%- endif -%}
    </div>
  </div>

  <div class="cart-item__errors">
    <div class="cart-item__error" role="alert"></div>
    {{- 'icon-info.svg' | inline_asset_content -}}
  </div>
</cart-line-item>
