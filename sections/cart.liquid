{% comment %}
  Cart page. <cart-page> (section-cart.js) swaps its contents from the HTML
  that cart-store.js bundles into each mutation; `data-cart-section` marks it
  for re-rendering. Line items and the summary are the same snippets the
  drawer uses.

  No `presets`: main section for the `cart` template.
{% endcomment %}
{{ 'cart.css' | asset_url | stylesheet_tag }}

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<div class="color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    <cart-page data-cart-section>
      {%- if cart.item_count > 0 -%}
        <div id="cart-main">
          <div class="cart-header">
            <h1 class="h2">{{ 'cart.title' | t }} (<cart-count>{{ cart.item_count }}</cart-count>)</h1>
            <a href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
          </div>

          <div class="cart-items">
            {%- for line_item in cart.items -%}
              {% render 'component-cart-line-item', line_item: line_item %}
            {%- endfor -%}
          </div>

          {% render 'component-cart-summary' %}
        </div>
      {%- else -%}
        <div class="cart__warnings">
          <h1 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h1>
          <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'general.continue_shopping' | t }}</a>

          {%- if shop.customer_accounts_enabled and customer == null -%}
            <h2>{{ 'sections.cart.login.title' | t }}</h2>
            <p class="cart__login-paragraph">
              {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </cart-page>
  </div>
</div>

<script src="{{ 'component-cart-count.js' | asset_url }}" type="module"></script>
<script src="{{ 'component-cart-line-item.js' | asset_url }}" type="module"></script>
<script src="{{ 'component-cart-discount.js' | asset_url }}" type="module"></script>
<script src="{{ 'section-cart.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "t:sections.cart.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
