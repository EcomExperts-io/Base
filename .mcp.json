{
  "mcpServers": {
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "shopify-dev-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@shopify/dev-mcp@latest"],
      "env": {
        "LIQUID": "true",
        "LIQUID_VALIDATION_MODE": "partial",
        "OPT_OUT_INSTRUMENTATION": "true"
      }
    }
  }
}
